{
  "name": "ryliox-frontend",
  "private": true,
  "version": "2.0.0",
  "packageManager": "bun@1.3.11",
  "type": "module",
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "scripts": {
    "build": "cross-env NODE_NO_WARNINGS=1 astro build",
    "build:watch": "cross-env NODE_NO_WARNINGS=1 astro build --watch",
    "check": "cross-env NODE_NO_WARNINGS=1 astro check",
    "lint": "cross-env NODE_NO_WARNINGS=1 tsc --noEmit && prettier --check \"src/**/*.{ts,tsx,astro}\" \"astro.config.mjs\"",
    "lint:fix": "cross-env NODE_NO_WARNINGS=1 tsc --noEmit && prettier --write \"src/**/*.{ts,tsx,astro}\" \"astro.config.mjs\"",
    "format": "prettier --write \"src/**/*.{ts,tsx,astro}\" \"astro.config.mjs\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,astro}\" \"astro.config.mjs\"",
    "test": "cross-env NODE_NO_WARNINGS=1 vitest run",
    "typecheck": "cross-env NODE_NO_WARNINGS=1 tsc --noEmit"
  },
  "overrides": {
    "@babel/core": "7.29.7",
    "fast-uri": "4.1.0",
    "js-yaml": "4.3.0",
    "picomatch": "4.0.4",
    "smol-toml": "1.7.0",
    "volar-service-yaml": "0.0.70",
    "yaml": "2.9.0",
    "yaml-language-server": "1.23.0"
  },
  "dependencies": {
    "@astrojs/react": "^6.0.0",
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-visually-hidden": "^1.2.7",
    "@tailwindcss/vite": "^4.3.2",
    "@tanstack/react-query": "^5.101.2",
    "astro": "^7.0.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.42.2",
    "i18next": "^26.3.4",
    "i18next-browser-languagedetector": "^8.2.1",
    "lucide-react": "^1.23.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-i18next": "^17.0.8",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.2",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@tailwindcss/postcss": "^4.3.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.1.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "autoprefixer": "^10.5.2",
    "cross-env": "^10.1.0",
    "jsdom": "^29.1.1",
    "playwright": "^1.61.1",
    "postcss": "^8.5.16",
    "prettier": "^3.9.4",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead",
    "Chrome >= 109",
    "Firefox >= 115",
    "Edge >= 109",
    "Safari >= 15",
    "iOS >= 15"
  ]
}
