---
import '../styles/global.css';
import App from '../components/App';
---

<!doctype html>
<html lang="es" dir="ltr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta
      name="description"
      content="Descarga libros técnicos de O'Reilly Learning en formato PDF y EPUB. Gestiona tu biblioteca técnica offline con descargas rápidas por capítulos y múltiples formatos."
    />
    <meta name="theme-color" content="#dc2626" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#d64a2c" media="(prefers-color-scheme: dark)" />
    <meta name="color-scheme" content="light dark" />

    <!-- Open Graph / Twitter -->
    <meta property="og:title" content="Ryliox — Descargador de libros O'Reilly" />
    <meta
      property="og:description"
      content="Descarga y gestiona tu biblioteca técnica de O'Reilly Learning en PDF y EPUB. Rápido, por capítulos y sin complicaciones."
    />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://ryliox.app" />
    <meta property="og:image" content="/og-image.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Ryliox — Descargador de libros O'Reilly" />
    <meta
      name="twitter:description"
      content="Descarga y gestiona tu biblioteca técnica de O'Reilly Learning."
    />
    <meta name="twitter:image" content="/og-image.png" />

    <!-- PWA -->
    <link rel="manifest" href="/manifest.json" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="Ryliox" />
    <link rel="apple-touch-icon" href="/icons/icon-192x192.png" />

    <!-- Preconnect & DNS-Prefetch -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="dns-prefetch" href="https://fonts.gstatic.com" />
    <link rel="preconnect" href="https://learning.oreilly.com" />
    <link rel="dns-prefetch" href="https://learning.oreilly.com" />

    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=Lora:ital,wght@0,500;0,600;1,400&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap"
    />

    <!-- Icons -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" href="/favicon.png" />

    <title>Ryliox — Descargador de libros O'Reilly</title>

    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "WebApplication",
        "name": "Ryliox",
        "description": "Descargador de libros t\u00e9cnicos de O'Reilly Learning en formato PDF y EPUB.",
        "url": "https://ryliox.app",
        "applicationCategory": "Multimedia",
        "operatingSystem": "All",
        "browserRequirements": "Requiere JavaScript. Compatible con Chrome, Firefox, Safari y Edge.",
        "offers": {
          "@type": "Offer",
          "price": "0",
          "priceCurrency": "USD"
        },
        "author": {
          "@type": "Organization",
          "name": "Ryliox"
        }
      }
    </script>

    <script is:inline>
      // Theme initialization - prevent flash
      (function () {
        const theme = localStorage.getItem('theme-preference') || 'system';
        const isDark =
          theme === 'dark' ||
          (theme === 'system' && window.matchMedia('(prefers-color-scheme: dark)').matches);
        if (isDark) {
          document.documentElement.classList.add('dark');
        }
      })();
    </script>

    <script is:inline>
      // Service Worker registration
      (function () {
        if ('serviceWorker' in navigator) {
          window.addEventListener('load', function () {
            navigator.serviceWorker
              .register('/service-worker.js')
              .then(function (registration) {
                console.log('ServiceWorker registered:', registration.scope);
              })
              .catch(function (error) {
                console.log('ServiceWorker registration failed:', error);
              });
          });
        }
      })();
    </script>

    <script is:inline>
      // Clear legacy service workers (dev cleanup)
      (() => {
        window.addEventListener('load', () => {
          const host = window.location.hostname;
          const isLocalHost = host === 'localhost' || host === '127.0.0.1';
          if (!isLocalHost) {
            return;
          }

          const clearLegacyRuntime = async () => {
            try {
              if ('serviceWorker' in navigator) {
                const registrations = await navigator.serviceWorker.getRegistrations();
                const ownRegistrations = registrations.filter(registration => {
                  const scriptUrl =
                    registration.active?.scriptURL ||
                    registration.waiting?.scriptURL ||
                    registration.installing?.scriptURL ||
                    '';
                  const normalized = scriptUrl.toLowerCase();
                  return normalized.includes('/service-worker.js') || normalized.includes('ryliox');
                });
                await Promise.all(ownRegistrations.map(registration => registration.unregister()));
              }

              if ('caches' in window) {
                const cacheKeys = await caches.keys();
                const ownCacheKeys = cacheKeys.filter(cacheKey =>
                  cacheKey.toLowerCase().startsWith('ryliox')
                );
                await Promise.all(ownCacheKeys.map(cacheKey => caches.delete(cacheKey)));
              }
            } catch (_error) {
              // Ignore cleanup failures in local environments.
            }
          };

          void clearLegacyRuntime();
        });
      })();
    </script>
  </head>
  <body>
    <div
      class="mx-auto flex min-h-screen w-full max-w-6xl flex-col gap-6 overflow-x-hidden px-4 pt-8 pb-[calc(6rem+env(safe-area-inset-bottom,0))] sm:px-6 sm:py-8 lg:px-8"
    >
      <App client:load />
    </div>
  </body>
</html>
