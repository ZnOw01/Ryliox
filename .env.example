# Ryliox configuration
#
# Copy this file to .env and change what you need. Every value below is the
# default, so an empty .env behaves the same as no .env at all.
#
# Precedence, highest first: process environment, .env, built-in defaults.
# Every setting also has a prefixed name, RYLIOX_<GROUP>__<FIELD>, for example
# RYLIOX_SERVER__PORT. See config.py for the full list.

# --- Server -----------------------------------------------------------------

# Use 0.0.0.0 only behind a proxy or in a container. Binding to anything other
# than a loopback address requires ADMIN_TOKEN.
HOST=127.0.0.1
PORT=8000

# development or production. Production disables the API docs, logs JSON,
# enforces ALLOWED_HOSTS, marks the admin session cookie Secure, and refuses
# to start without ADMIN_TOKEN, SESSION_ENCRYPTION_KEY and AUDIT_HMAC_KEY.
ENVIRONMENT=development

# Bearer token for the API when the server is reachable from other machines.
# At least 32 characters.
# ADMIN_TOKEN=

# Skip the admin token when a trusted local proxy fronts a 0.0.0.0 bind.
ALLOW_UNAUTHENTICATED_LOCAL_PROXY=false

# --- Paths (relative to the repository root unless absolute) -----------------

OUTPUT_DIR=./output
# Downloads are confined to this directory. Defaults to OUTPUT_DIR.
# OUTPUT_ROOT=./output
# Queue database, session database, error logs and the audit log live here.
DATA_DIR=./data
# COOKIES_FILE=./data/cookies.json
# SESSION_DB_FILE=./data/session.sqlite3

# --- Keys --------------------------------------------------------------------
# Outside production, missing keys are generated once and kept in the user
# configuration directory (~/.config/ryliox on Linux).

# Fernet key that encrypts stored cookies. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# SESSION_ENCRYPTION_KEY=
# Key for the audit log's hash chain (64 hex characters).
# AUDIT_HMAC_KEY=

# --- O'Reilly requests -------------------------------------------------------

BASE_URL=https://learning.oreilly.com
# Seconds between requests to O'Reilly.
REQUEST_DELAY=0.5
REQUEST_TIMEOUT=30
REQUEST_RETRIES=2
REQUEST_RETRY_BACKOFF=0.5
# Upper bound for one whole download job. Raise it for books with many images.
REQUEST_TIMEOUT_SECONDS=600
# Browser whose TLS fingerprint requests copy: chrome, safari17_0, firefox... O'Reilly's
# Akamai edge blocks a real session sent with plain Python's fingerprint, so leave it on.
# An empty value sends plain httpx requests.
IMPERSONATE=chrome
# Leave these unset: the impersonated browser sends matching values, and a different
# User-Agent contradicts its fingerprint.
# USER_AGENT=
# ACCEPT=
# ACCEPT_ENCODING=
# ACCEPT_LANGUAGE=
# Extra request headers, sent as X-<name>.
# RYLIOX_HTTP__EXTRA_HEADERS={"Trace": "enabled"}

# --- HTTP security -----------------------------------------------------------

# Comma-separated values accepted in the Host header. Enforced in production only.
ALLOWED_HOSTS=localhost,127.0.0.1,::1
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
ENABLE_SECURITY_HEADERS=true
# Enable HSTS only after HTTPS works; browsers then refuse plain HTTP.
ENABLE_HSTS=false
HSTS_MAX_AGE=31536000
CSP_POLICY=default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; connect-src 'self'; frame-ancestors 'none';
MAX_REQUEST_SIZE_MB=10

# Per-IP limit for POST /api/download and POST /api/cookies.
RATE_LIMIT_MAX_REQUESTS=5
RATE_LIMIT_WINDOW_SECONDS=60

# --- Audit log, logging and metrics -----------------------------------------

AUDIT_ENABLED=true
# AUDIT_LOG_FILE=./data/audit.log
AUDIT_RETENTION_DAYS=365
AUDIT_FSYNC_ENABLED=true

LOG_LEVEL=INFO
# Prometheus metrics at /metrics.
ENABLE_METRICS=true

# --- In-memory caches (entries and seconds) -----------------------------------

CACHE_MAXSIZE_BOOKS=256
CACHE_TTL_BOOKS=3600
CACHE_MAXSIZE_CHAPTERS=128
CACHE_TTL_CHAPTERS=1800
CACHE_MAXSIZE_SEARCH=64
CACHE_TTL_SEARCH=300

# --- Launcher (python -m launcher) ------------------------------------------
# These are read by the launcher only, from the process environment.

# RYLIOX_VENV=./.run/venv
# RYLIOX_TIMEOUT_UV=300
# RYLIOX_TIMEOUT_BUN=300
# RYLIOX_TIMEOUT_DOCKER=120
# RYLIOX_MAX_SERVER_LOG_BYTES=10485760
# RYLIOX_MAX_SERVER_LOG_BACKUPS=5
